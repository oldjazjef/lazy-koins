{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@lazykoins/engine": ["./libs/engine/src/index.ts"],
      "@lazykoins/ui/button": ["./libs/ui/button/src/index.ts"],
      "@lazykoins/ui/utils": ["./libs/ui/utils/src/index.ts"],
      "@lazykoins/ui/input": ["./libs/ui/input/src/index.ts"],
      "@lazykoins/ui/label": ["./libs/ui/label/src/index.ts"],
      "@lazykoins/ui/card": ["./libs/ui/card/src/index.ts"],
      "@lazykoins/ui/badge": ["./libs/ui/badge/src/index.ts"],
      "@lazykoins/ui/textarea": ["./libs/ui/textarea/src/index.ts"],
      "@lazykoins/ui/sonner": ["./libs/ui/sonner/src/index.ts"],
      "@lazykoins/ui/dialog": ["./libs/ui/dialog/src/index.ts"],
      "@lazykoins/ui/table": ["./libs/ui/table/src/index.ts"],
      "@lazykoins/ui/skeleton": ["./libs/ui/skeleton/src/index.ts"],
      "@lazykoins/ui/separator": ["./libs/ui/separator/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "private"]
}
