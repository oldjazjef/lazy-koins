// Prisma schema for apps/api.
//
// Conventions (same as surf-lend / etx-working-time-manager, see CLAUDE.md "Database"):
//
//  1. `@default(uuid(7))` keys — generated client-side, time-ordered. Those columns carry no DDL
//     default, so anything inserting outside Prisma must supply an id (scripts/dev/seed.mjs does).
//  2. snake_case table/column names via @@map/@map, so the SQL reads like SQL.
//  3. SQLite (one file, `DATABASE_URL=file:…`). No native uuid/timestamptz types: ids are TEXT,
//     DateTime values are stored in UTC by Prisma, and the enums below are TEXT that hand-written
//     CHECK constraints in the migrations keep honest.
//  4. Quantities, rates and CHF amounts (coming with bookings) are **decimal strings in TEXT
//     columns**, never REAL: crypto quantities have up to 18 decimals (CLAUDE.md, Numbers).
//  5. Every row belongs to one user; someone else's row reads as absent (404).
//
// The datasource URL lives in prisma.config.ts (Prisma 7 removed `url` from this block).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // apps/api builds to CommonJS through webpack. Prisma 7 emits ESM by default, which would force
  // `"type": "module"` onto the whole repo; `cjs` keeps the generated client bundleable.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "sqlite"
}

/// F4.1: in Arbeit / geprüft / abgeschlossen. A closed project is read-only (F4.5).
enum ProjectStatus {
  in_progress
  reviewed
  closed

  @@map("project_status")
}

/// F7.7: country rules are exchangeable; only Switzerland so far.
enum Country {
  CH

  @@map("country")
}

/// A person. In the web app identified by their Firebase Authentication uid; `dev:<email>` with
/// AUTH_MODE=dev; `local:owner` — the single user — in the desktop app (AUTH_MODE=local).
///
/// Created on the first authenticated request (see auth/principal.service.ts).
model User {
  id             String   @id @default(uuid(7))
  /// Firebase uid, `dev:<email>` or `local:owner`.
  identityUid    String   @unique @map("identity_uid")
  email          String
  displayName    String   @map("display_name")
  /// Firebase's `sign_in_provider` claim (`password`, `google.com`), or `dev` / `local`.
  signInProvider String   @map("sign_in_provider")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  projects      Project[]
  storedFiles   StoredFile[]
  mappings      ImportMapping[]
  settings      UserSettings?
  aiSettings    AiSettings?
  mailSettings  MailSettings?
  mailTemplates MailTemplate[]
  rates         UserRate[]
  wallets       Wallet[]
  chainSettings ChainSettings?
  setupProgress SetupProgress?
  pin           UserPin?

  @@map("user")
}

/// One tax year of one person (F4.1): "Steuern 2025", Switzerland, canton ZH.
model Project {
  id        String        @id @default(uuid(7))
  ownerId   String        @map("owner_id")
  name      String
  taxYear   Int           @map("tax_year")
  country   Country       @default(CH)
  /// Two-letter canton code; which codes exist is checked by the API against the country.
  canton    String
  status    ProjectStatus @default(in_progress)
  notes     String        @default("")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  /// Deleting an account deletes its projects (F2.2).
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  files       ProjectFile[]
  rates       ProjectRate[]
  snapshots   CalculationSnapshot[]
  corrections Correction[]
  itemStates  OpenItemState[]
  exports     ProjectExport[]
  wallets        ProjectWallet[]
  walletBalances WalletManualBalance[]
  hintStates  ProjectHintState[]
  mailLog     MailLog[]
  sentState   ProjectSentState?
  carryovers  ProjectCarryover[]

  @@index([ownerId, taxYear])
  @@map("project")
}

/// An original file, byte for byte (F5.3), content-addressed by SHA-256 **per owner**: the same
/// bytes uploaded twice by one user are one row (F5.4, F4.4), two users never share a row. It is
/// deleted when no project_file references it any more (F5.7) — in the same transaction.
model StoredFile {
  id           String   @id @default(uuid(7))
  ownerId      String   @map("owner_id")
  /// Lower-case hex SHA-256 of `bytes` — also the `sourceFileId` every record carries (F7.5).
  sha256       String
  bytes        Bytes
  size         Int
  /// `text/csv`, `application/vnd.openxmlformats-officedocument.spreadsheetml.sheet`, `application/pdf`.
  mediaType    String   @map("media_type")
  /// csv | xlsx | pdf — decided from the bytes, not the name. CHECK in the migration.
  kind         String
  /// The name of the first upload; the download uses it.
  originalName String   @map("original_name")
  createdAt    DateTime @default(now()) @map("created_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectFiles ProjectFile[]

  @@unique([ownerId, sha256])
  @@map("stored_file")
}

/// A mapping spec (libs/engine `mapping/`): turns one export layout into standard records.
/// Owner-scoped; `spec` is the validated JSON as text (CHECK json_valid).
model ImportMapping {
  id          String   @id @default(uuid(7))
  ownerId     String   @map("owner_id")
  name        String
  platform    String
  spec        String
  /// The spec's normalised headers, sorted (`mappingFingerprint`), for listing and lookup.
  fingerprint String
  /// Spec format version (`MAPPING_VERSION`).
  version     Int
  /// ai | manual | copied. CHECK in the migration.
  origin      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files ProjectFile[]

  @@index([ownerId])
  @@map("import_mapping")
}

/// A stored file as part of one project (F5.5): how it was read and what it contributed.
model ProjectFile {
  id           String   @id @default(uuid(7))
  projectId    String   @map("project_id")
  fileId       String   @map("file_id")
  displayName  String   @map("display_name")
  /// standard | mapped | needs_mapping | evidence_only. CHECK in the migration.
  status       String
  /// `standard-v1` or `mapping:<id>` — the importer that read it; null otherwise.
  importerId   String?  @map("importer_id")
  mappingId    String?  @map("mapping_id")
  /// The platform(s) the records name, comma-separated in order of appearance.
  platform     String?
  /// ISO dates over bookings and balances (F5.5).
  periodFrom   String?  @map("period_from")
  periodTo     String?  @map("period_to")
  bookingCount Int      @default(0) @map("booking_count")
  holdingCount Int      @default(0) @map("holding_count")
  errorCount   Int      @default(0) @map("error_count")
  /// JSON array of coverage entries per platform/account (F5.8).
  coverage     String   @default("[]")
  /// `uploaded`, `from_project:<id>` when the bytes were already in another project (F4.4), or
  /// `derived_from:<project file id>` for a standard-format file the AI converted from a PDF, or
  /// `wallet:<wallet id>` for the standard-format records a wallet fetch derived (F6.3).
  origin       String   @default("uploaded")
  addedAt      DateTime @default(now()) @map("added_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  mapping ImportMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)

  walletEvidence WalletManualBalance[]

  @@unique([projectId, fileId])
  @@index([fileId])
  @@index([mappingId])
  @@map("project_file")
}

/// Personal settings (F11.1–F11.3) and the API keys a user stores (F6.7). Keys are sealed with
/// AES-256-GCM (`SETTINGS_ENCRYPTION_KEY`) and never returned — the API answers with a hint only.
model UserSettings {
  userId       String   @id @map("user_id")
  /// Name on the exports (F10.4); empty = the account's display name.
  displayName  String   @default("") @map("display_name")
  /// Canton of residence, two letters, or empty.
  canton       String   @default("")
  advisorName  String   @default("") @map("advisor_name")
  advisorEmail String   @default("") @map("advisor_email")
  /// F11.2. Only `de-CH` / `dd.MM.yyyy` exist so far. CHECK in the migration.
  numberFormat String   @default("de-CH") @map("number_format")
  dateFormat   String   @default("dd.MM.yyyy") @map("date_format")
  /// F11.3: rate lookups on the internet allowed.
  onlineRates  Boolean  @default(true) @map("online_rates")
  /// `enc:v1:…` (secret-box.ts), or null.
  coingeckoKey String?  @map("coingecko_key")
  etherscanKey String?  @map("etherscan_key")
  /// JSON object symbol → CoinGecko id, overriding the built-in table.
  coingeckoIds String   @default("{}") @map("coingecko_ids")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// A stored rate of a project (F7.4): a price (asset in CHF/USD) or an exchange rate (USD, EUR in
/// CHF) for one day, with its source. `manual` rows are the user's overrides. The calculation reads
/// only these rows — fetching is a separate, explicit action.
model ProjectRate {
  id        String   @id @default(uuid(7))
  projectId String   @map("project_id")
  /// price | fx. CHECK in the migration.
  kind      String
  asset     String
  /// CHF | USD. CHECK in the migration.
  currency  String
  /// ISO date.
  date      String
  /// Decimal string.
  value     String
  /// manual | estv | binance | coingecko | ecb. CHECK in the migration.
  source    String
  /// Shown with the source, e.g. "ESTV-Kursliste 2025, Stand 02.10.2026" for the automatic ESTV
  /// values (F7.4a); null for everything else.
  note      String?
  fetchedAt DateTime @default(now()) @map("fetched_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, asset, currency, date, source])
  @@map("project_rate")
}

/// The result of one calculation (F7.6) as JSON, with the hash of its input: same hash, same
/// result. `records` holds the records behind the figures (F7.5) separately — it is large and only
/// read for drill-downs.
model CalculationSnapshot {
  id            String   @id @default(uuid(7))
  projectId     String   @map("project_id")
  inputHash     String   @map("input_hash")
  engineVersion Int      @map("engine_version")
  result        String
  records       String
  /// Decimal strings, for the project list (F4.2).
  wealthChf     String   @map("wealth_chf")
  incomeChf     String   @map("income_chf")
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("calculation_snapshot")
}

/// A correction (F9): data applied on top of the imported records, never an edit. Undo sets
/// `undone_at`; the row stays as history (F9.4).
model Correction {
  id        String    @id @default(uuid(7))
  projectId String    @map("project_id")
  /// price_override | reclassify | manual_booking | manual_holding. CHECK in the migration.
  type      String
  /// The validated correction data (libs/engine `CorrectionDataSchema`) as JSON.
  data      String
  reason    String
  createdAt DateTime  @default(now()) @map("created_at")
  undoneAt  DateTime? @map("undone_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("correction")
}

/// F8.2: an open item ticked off and/or annotated, keyed by the item's stable key.
model OpenItemState {
  projectId String   @map("project_id")
  itemKey   String   @map("item_key")
  done      Boolean  @default(false)
  note      String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, itemKey])
  @@map("open_item_state")
}

/// A generated statement (F10.5), kept with its date.
model ProjectExport {
  id         String   @id @default(uuid(7))
  projectId  String   @map("project_id")
  /// simple_pdf | simple_xlsx | detailed_pdf | detailed_xlsx | internal_report_pdf |
  /// internal_report_xlsx. CHECK in the migrations (widened by 20261008090000).
  kind       String
  fileName   String   @map("file_name")
  mediaType  String   @map("media_type")
  bytes      Bytes
  size       Int
  snapshotId String?  @map("snapshot_id")
  wealthChf  String   @map("wealth_chf")
  incomeChf  String   @map("income_chf")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_export")
}

/// The AI plugin's settings of one user (F5.13, F5.14) — its own table, one row per user, created
/// on first save. The API key is stored only encrypted (AES-256-GCM with SETTINGS_ENCRYPTION_KEY,
/// `ai/domain/secret-box.ts`) and never returned; `api_key_hint` keeps its last four characters.
model AiSettings {
  userId       String    @id @map("user_id")
  enabled      Boolean   @default(false)
  /// openai_compatible | anthropic. CHECK in the migration.
  provider     String    @default("openai_compatible")
  /// e.g. https://api.openai.com/v1 or http://localhost:11434/v1; empty = the provider's default.
  baseUrl      String    @default("") @map("base_url")
  /// Empty = the provider's default model.
  model        String    @default("")
  /// `enc:v1:<iv>:<tag>:<ciphertext>`; null = no key (e.g. a local Ollama).
  apiKeyCipher String?   @map("api_key_cipher")
  apiKeyHint   String?   @map("api_key_hint")
  /// F5.14: when the user first agreed to send file excerpts to the provider; null = not yet.
  consentAt    DateTime? @map("consent_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

/// A wallet of one user (F6.1): a public address — or a Bitcoin xpub/ypub/zpub — with a label, the
/// networks it is used on and notes. Seed phrases and private keys never get here (F6.2: refused
/// before anything is stored). Projects include wallets through `project_wallet`.
model Wallet {
  id           String   @id @default(uuid(7))
  ownerId      String   @map("owner_id")
  label        String
  /// The public identifier as entered (trimmed).
  address      String
  /// evm | bitcoinAddress | bitcoinXpub | solana | cardano | polkadot | cosmos. CHECK in the migration.
  addressKind  String   @map("address_kind")
  /// JSON array of network ids (`ethereum`, `bitcoin`, …).
  networks     String   @default("[]")
  notes        String   @default("")
  /// F6.4: JSON `{ checkedAt, results: [{ network, used, txCount, error }] }`; null = never checked.
  networkCheck String?  @map("network_check")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner          User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects       ProjectWallet[]
  data           WalletNetworkData[]
  tokenOverrides WalletTokenOverride[]
  balances       WalletManualBalance[]

  @@index([ownerId])
  @@map("wallet")
}

/// A wallet included in a project; its fetched records reach the project as a derived file.
model ProjectWallet {
  projectId String   @map("project_id")
  walletId  String   @map("wallet_id")
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wallet  Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@id([projectId, walletId])
  @@index([walletId])
  @@map("project_wallet")
}

/// The last fetch of one wallet on one network (F6.3): the normalised movements as JSON (amounts
/// as decimal strings), what the network delivers, and the error of a failed fetch (a code and the
/// provider's message, never a key).
model WalletNetworkData {
  walletId    String   @map("wallet_id")
  network     String
  /// ok | error. CHECK in the migration.
  status      String
  errorCode   String?  @map("error_code")
  errorDetail String?  @map("error_detail")
  /// JSON array of ChainMovement (libs/engine wallets/wallet-records.ts).
  movements   String   @default("[]")
  /// JSON: current balances (information only), truncation, notes.
  info        String   @default("{}")
  fetchedAt   DateTime @map("fetched_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@id([walletId, network])
  @@map("wallet_network_data")
}

/// F6.6: a token the user marked "kein Spam" (overrides the heuristics) on one network.
model WalletTokenOverride {
  walletId  String   @map("wallet_id")
  network   String
  /// Contract / mint, or `native`.
  tokenKey  String   @map("token_key")
  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@id([walletId, network, tokenKey])
  @@map("wallet_token_override")
}

/// F6.5: a balance entered by hand for a wallet on a network at a date (the project's 31.12.),
/// with its evidence — a PDF in the project's files (evidence only). Becomes a holding record.
model WalletManualBalance {
  id             String   @id @default(uuid(7))
  projectId      String   @map("project_id")
  walletId       String   @map("wallet_id")
  network        String
  asset          String
  /// Decimal string.
  quantity       String
  /// ISO date.
  asOf           String   @map("as_of")
  evidenceFileId String?  @map("evidence_file_id")
  note           String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wallet   Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  evidence ProjectFile? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)

  @@index([projectId, walletId])
  @@index([walletId])
  @@index([evidenceFileId])
  @@map("wallet_manual_balance")
}

/// F6.7: what the wallet lookups need besides the Etherscan key (kept in `user_settings`): the
/// Helius key and Solana RPC URL, the Subscan key (sealed like every key) and address overrides.
model ChainSettings {
  userId       String   @id @map("user_id")
  /// `enc:v1:…` or null.
  heliusKey    String?  @map("helius_key")
  /// Any Solana JSON-RPC URL; empty = Helius with the key, else the public endpoint.
  solanaRpcUrl String   @default("") @map("solana_rpc_url")
  subscanKey   String?  @map("subscan_key")
  /// Esplora-compatible API; empty = https://mempool.space/api.
  esploraUrl   String   @default("") @map("esplora_url")
  /// Koios; empty = https://api.koios.rest/api/v1.
  koiosUrl     String   @default("") @map("koios_url")
  /// Cosmos LCD (REST); empty = the public endpoint.
  cosmosLcdUrl String   @default("") @map("cosmos_lcd_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chain_settings")
}

/// The mailer (SMTP) of one user (F11.10) — its own table, one row per user, created on first
/// save. The password is stored only sealed (AES-256-GCM, `common/crypto/secret-box.ts`) and never
/// returned; `password_hint` keeps its last four characters.
model MailSettings {
  userId         String   @id @map("user_id")
  enabled        Boolean  @default(false)
  host           String   @default("")
  port           Int      @default(587)
  /// tls (implicit, usually 465) | starttls (usually 587) | none. CHECK in the migration.
  security       String   @default("starttls")
  username       String   @default("")
  /// `enc:v1:<iv>:<tag>:<ciphertext>`; null = no password stored.
  passwordCipher String?  @map("password_cipher")
  passwordHint   String?  @map("password_hint")
  fromName       String   @default("") @map("from_name")
  fromAddress    String   @default("") @map("from_address")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mail_settings")
}

/// A user's own text template for the mail to the Treuhänder (F11.10), per language. No row =
/// the built-in default of that language (`mail/domain/mail-template.ts`).
model MailTemplate {
  userId    String   @map("user_id")
  /// F11.2 language; only `de-CH` so far. CHECK in the migration.
  language  String
  subject   String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, language])
  @@map("mail_template")
}

/// One mail sent (or tried) from a project to the Treuhänder (F10.6a): the protocol. Never a
/// password; the body is not kept.
model MailLog {
  id          String   @id @default(uuid(7))
  projectId   String   @map("project_id")
  toAddress   String   @map("to_address")
  ccAddress   String?  @map("cc_address")
  subject     String
  /// JSON array of `{ exportId, fileName, size }`. CHECK json_valid in the migration.
  attachments String   @default("[]")
  /// sent | failed. CHECK in the migration.
  status      String
  /// A short, redacted error summary when `failed`.
  error       String?
  messageId   String?  @map("message_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("mail_log")
}

/// F4.7: the documents went to the Treuhänder — set automatically by a successful send (F10.6a)
/// or by hand ("als gesendet markieren"); deleting the row is "rückgängig".
model ProjectSentState {
  projectId       String   @id @map("project_id")
  sentToAdvisorAt DateTime @map("sent_to_advisor_at")
  sentTo          String   @default("") @map("sent_to")
  /// mail | post | personal | other. CHECK in the migration.
  sentVia         String   @map("sent_via")
  sentNote        String   @default("") @map("sent_note")
  /// JSON array of project_export ids that went out. CHECK json_valid in the migration.
  sentExports     String   @default("[]") @map("sent_exports")
  mailLogId       String?  @map("mail_log_id")
  /// Input hash of the latest calculation when it was sent ("seit dem Versand geändert").
  snapshotHash    String?  @map("snapshot_hash")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_sent_state")
}

/// A user's own rate cache (F11.4): daily series fetched for the dashboard over any period, shared
/// by all projects of the user for the dashboard only — a project's calculation reads only its
/// own `project_rate` rows (F7.4). No overrides here (`manual` lives in the project).
model UserRate {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  /// price | fx. CHECK in the migration.
  kind      String
  asset     String
  /// CHF | USD. CHECK in the migration.
  currency  String
  /// ISO date.
  date      String
  /// Decimal string.
  value     String
  /// binance | coingecko | ecb. CHECK in the migration.
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, asset, currency, date, source])
  @@map("user_rate")
}

/// What a project took over from another one (F4.4, F4.4a) or from a package (F10.8), one row per
/// item — so the new project shows "aus Projekt X". The source project may be deleted later; its
/// name is kept. A carried-over open item lives here (`data` = the item and its note) and is
/// ticked off through `open_item_state` with the key `carried:<id>`.
model ProjectCarryover {
  id                String   @id @default(uuid(7))
  projectId         String   @map("project_id")
  /// null for a package import.
  sourceProjectId   String?  @map("source_project_id")
  sourceProjectName String   @map("source_project_name")
  /// project | file | correction | open_item | notes. CHECK in the migration.
  kind              String
  /// The new project's item (project file id, correction id), when there is one.
  ref               String?
  label             String   @default("")
  /// JSON. CHECK json_valid in the migration.
  data              String   @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_carryover")
}

/// The ESTV Kursliste (ICTax) of one tax year, **once per deployment** (F7.4a) — not per user: the
/// newest official export (`THIRD.INIT.<n>`) that was downloaded, with its version metadata. Only
/// the newest version per year is kept; its year-end values are in `estv_rate`.
model EstvKursliste {
  year          Int      @id
  /// e.g. THIRD.INIT.220 (the suffix is the schema version, 220 = 2.2.0).
  exportType    String   @map("export_type")
  exportDate    DateTime @map("export_date")
  fileHash      String   @map("file_hash")
  fileName      String   @map("file_name")
  /// The XML namespace version, e.g. 2.2.0.
  schemaVersion String   @map("schema_version")
  downloadedAt  DateTime @map("downloaded_at")
  entryCount    Int      @map("entry_count")
  cryptoCount   Int      @map("crypto_count")

  rates EstvRate[]

  @@map("estv_kursliste")
}

/// One year-end value of the Kursliste: a cryptocurrency or currency (`currencyNote`) or a
/// year-end exchange rate (`exchangeRateYearEnd`), in CHF per unit. Replaced with its year.
model EstvRate {
  id          String  @id @default(uuid(7))
  year        Int
  /// crypto | currency | fx. CHECK in the migration.
  kind        String
  /// The ICTax entity id (null for exchange rates).
  ictaxId     String? @map("ictax_id")
  /// The ticker (securityAppendix) or the ISO currency.
  symbol      String
  name        String
  valorNumber String? @map("valor_number")
  isin        String?
  /// Decimal string, CHF per unit.
  value       String

  kursliste EstvKursliste @relation(fields: [year], references: [year], onDelete: Cascade)

  @@index([year, symbol])
  @@map("estv_rate")
}

/// The last check for a newer Kursliste of one tax year (F7.4a), successful or not.
model EstvCheck {
  year      Int      @id
  checkedAt DateTime @map("checked_at")
  /// updated | current | failed. CHECK in the migration.
  outcome   String
  /// What went wrong (no secrets); null on success.
  error     String?

  @@map("estv_check")
}

/// F11.0s: where a user is in the setup wizard. One row per user, created on the first step
/// change. `steps` = JSON object step id → open | done | skipped | error (CHECK json_valid);
/// `completed_at` is set by "App starten" — until then the app sends the user to /app/setup.
model SetupProgress {
  userId      String    @id @map("user_id")
  steps       String    @default("{}")
  /// The step shown last, so a resumed wizard opens there.
  currentStep String    @default("profile") @map("current_step")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("setup_progress")
}

/// F11.0p: the PIN of one user — only a slow salted hash (scrypt, `pin/domain/pin-hash.ts`), never
/// the PIN. Wrong attempts are counted here so the waiting time survives a restart.
model UserPin {
  userId            String    @id @map("user_id")
  /// `scrypt$<logN>$<r>$<p>$<salt b64>$<hash b64>`. CHECK in the migration.
  pinHash           String    @map("pin_hash")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  /// No unlock attempt before this moment (the growing delay); null = right away.
  nextAttemptAt     DateTime? @map("next_attempt_at")
  /// Web: too many failures — unlocking needs a sign-in after this moment.
  reloginRequiredAt DateTime? @map("relogin_required_at")
  /// Lock after this many minutes without activity (1–240).
  autoLockMinutes   Int       @default(15) @map("auto_lock_minutes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_pin")
}

/// A dismissed F5.8 hint ("Als in Ordnung markieren" / "Ignorieren"), keyed by the hint's stable
/// key so it survives recalculation and new uploads. No row = open.
model ProjectHintState {
  projectId String   @map("project_id")
  hintKey   String   @map("hint_key")
  /// done | ignored (CHECK)
  status    String
  note      String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, hintKey])
  @@map("project_hint_state")
}
