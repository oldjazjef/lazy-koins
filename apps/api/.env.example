# Copy to apps/api/.env and fill in. `.env` is git-ignored; this file is the documented shape.
# Every variable is validated at boot by apps/api/src/config/env.ts — a bad value stops the process.

NODE_ENV=development
PORT=3333

# SQLite file. A relative path resolves against the working directory — the repo root for every
# pnpm/nx command — so this is <repo>/.data/lazykoins.db (git-ignored). Containers use an absolute
# path on a volume, e.g. file:/data/lazykoins.db.
DATABASE_URL=file:./.data/lazykoins.db

# --- HTTP ---
# Reverse proxies in front of the API (0 locally; 2 behind Coolify: Traefik + nginx).
TRUST_PROXY_HOPS=0
PUBLIC_API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:4200

# --- Authentication ---
# `firebase` (default, production web app) verifies Firebase ID tokens.
# `dev` accepts `dev:<email>` as the bearer token — no Firebase project needed. Refused in production.
# `local` (desktop app): no token, every request is LOCAL_USER_EMAIL; needs LOCAL_MODE=true and
#   makes the API listen on 127.0.0.1 only.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=your-firebase-project-id
LOCAL_MODE=
LOCAL_USER_EMAIL=local@lazykoins.local

# --- Settings ---
# Encrypts the API keys users save in their settings (AI provider, CoinGecko, Etherscan) with AES-256-GCM. Any long
# random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Empty = keys cannot be saved (a local Ollama / LM Studio without a key still works).
SETTINGS_ENCRYPTION_KEY=
# May users point the AI plugin at private/loopback hosts (local Ollama, LM Studio)? Empty =
# yes with AUTH_MODE=local/dev, no with firebase (the API sends the requests: SSRF on a server).
AI_ALLOW_PRIVATE_URLS=
# May users send mail through private/loopback SMTP hosts (a local relay, `node
# scripts/dev/smtp-sink.mjs`)? Empty = yes with AUTH_MODE=local/dev, no with firebase.
MAIL_ALLOW_PRIVATE_HOSTS=

# OpenAPI document + Scalar reference at /api/reference. Empty = on except with
# NODE_ENV=production; `true`/`false` decide explicitly (e.g. `true` on a test server).
API_DOCS=

# --- Rates, exports ---
# Chromium for PDF exports; empty = the one from `pnpm exec playwright-core install chromium`.
PDF_CHROMIUM_PATH=
# `false` = no rate lookups on the internet for anyone (F11.3); stored and manual rates still work.
RATES_ONLINE=true
# Development only: ms to wait before each rate series, to watch the app's activity indicator.
RATES_DEV_DELAY_MS=0
# F7.4a: download the ESTV Kursliste (ICTax) automatically (on demand + daily check for a newer
# version, once per deployment). `false` = off; the manual Kursliste import stays.
ESTV_AUTO=true
# The ICTax API. Only for a local fake server: `node scripts/dev/fake-ictax-server.mjs` →
# http://localhost:11436
ESTV_BASE_URL=https://www.ictax.admin.ch
