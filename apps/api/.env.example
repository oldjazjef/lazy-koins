# Copy to apps/api/.env and fill in. `.env` is git-ignored; this file is the documented shape.
# Every variable is validated at boot by apps/api/src/config/env.ts — a bad value stops the process.

NODE_ENV=development
PORT=3333

# SQLite file. A relative path resolves against the working directory — the repo root for every
# pnpm/nx command — so this is <repo>/.data/lazykoins.db (git-ignored). Containers use an absolute
# path on a volume, e.g. file:/data/lazykoins.db.
DATABASE_URL=file:./.data/lazykoins.db

# --- HTTP ---
# Reverse proxies in front of the API (0 locally; 2 behind Coolify: Traefik + nginx).
TRUST_PROXY_HOPS=0
PUBLIC_API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:4200

# --- Authentication ---
# `firebase` (default, production web app) verifies Firebase ID tokens.
# `dev` accepts `dev:<email>` as the bearer token — no Firebase project needed. Refused in production.
# `local` (desktop app): no token, every request is LOCAL_USER_EMAIL; needs LOCAL_MODE=true and
#   makes the API listen on 127.0.0.1 only.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=your-firebase-project-id
LOCAL_MODE=
LOCAL_USER_EMAIL=local@lazykoins.local

# OpenAPI document + Scalar reference at /api/reference. Empty = on except with
# NODE_ENV=production; `true`/`false` decide explicitly (e.g. `true` on a test server).
API_DOCS=

# --- Settings, rates, exports ---
# Seals the API keys users store (CoinGecko, Etherscan) with AES-256-GCM. Any random string of at
# least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Empty = storing keys is refused. Changing it makes stored keys unreadable.
SETTINGS_ENCRYPTION_KEY=
# Chromium for PDF exports; empty = the one from `pnpm exec playwright-core install chromium`.
PDF_CHROMIUM_PATH=
# `false` = no rate lookups on the internet for anyone (F11.3); stored and manual rates still work.
RATES_ONLINE=true
