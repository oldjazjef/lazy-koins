  "scripts": {
    "prepare": "node scripts/dev/install-hooks.mjs && nx run api:db:generate",
    "start": "nx serve web",
    "start:api": "nx serve api",
    "start:full": "pnpm db:deploy && nx run-many -t serve -p api web --parallel=2",
    "build": "nx build web",
    "build:api": "nx build api",
    "test": "vitest run",
    "test:integration": "node scripts/dev/with-test-db.mjs vitest run --config apps/api/vitest.integration.config.ts",
    "lint": "nx run-many -t lint",
    "lint:budget": "node scripts/check-lint-budget.mjs",
    "ci:verify": "pnpm lint && pnpm lint:budget && pnpm format:check && pnpm test && nx run-many -t build typecheck",
    "ci:integration": "pnpm db:reset:test && pnpm db:deploy:test && pnpm test:integration",
    "check": "pnpm ci:verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:deploy:test": "node scripts/dev/with-test-db.mjs pnpm nx run api:db:deploy",
    "db:generate": "nx run api:db:generate",
    "db:deploy": "nx run api:db:deploy",
    "db:migrate": "nx run api:db:migrate",
    "db:studio": "nx run api:db:studio",
    "db:seed": "node scripts/dev/seed.mjs",
    "db:reset:test": "node scripts/dev/with-test-db.mjs --reset",
    "private:inspect": "node scripts/private-inspect.mjs",
    "private:load": "node scripts/dev/load-private.mjs"
  },
